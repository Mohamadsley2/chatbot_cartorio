# Credenciais da WhatsApp Cloud API (Meta).
# Copie este arquivo para .env e preencha. O .env NÃO vai para o git.

# Painel da Meta > seu app > WhatsApp > Configuração da API
# Use o token permanente do usuário de sistema, não o token de teste de 24h.
WHATSAPP_TOKEN=

# ID do número de telefone do cartório (não é o número em si).
WHATSAPP_PHONE_NUMBER_ID=

# Senha que nós inventamos. Tem que ser exatamente igual à digitada no campo
# "Verificar token" ao cadastrar o webhook no painel.
WHATSAPP_VERIFY_TOKEN=

# Painel da Meta > Configurações do app > Básico > Chave secreta do app.
# Serve para conferir que cada webhook recebido veio mesmo da Meta.
WHATSAPP_APP_SECRET=

# Porta local do webhook (opcional, padrão 3000).
PORT=3000
